    "kosmos": {
      "description": "Agente de arquitectura \u00e2\u20ac\u201d an\u00c3\u00a1lisis de c\u00c3\u00b3digo, diagramas C4, documentaci\u00c3\u00b3n t\u00c3\u00a9cnica",
      "mode": "subagent",
      "color": "#7B68EE",
      "steps": 10,
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "ask",
        "list": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "bash": {
          "git *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "find *": "allow",
          "tree *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "npx *": "allow",
          "uvx *": "allow",
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "ask"
        }
      },
      "tools": {
        "depwire_*": true,
        "structurizr_*": true,
        "excalidraw_*": true,
        "git_*": true,
        "lucidity_*": true,
        "agy-bridge_agy_ask_sonnet": true,
        "agy-bridge_agy_ask_opus": true,
        "agy-bridge_agy_ask_gpt55": true,
        "agy-bridge_agy_ask_gpt55_thinking": true,
        "kaos-kanban_*": true
      }
    },
    "kratos": {
      "description": "Agente de c\u00c3\u00b3digo \u00e2\u20ac\u201d memoria experiencial, generaci\u00c3\u00b3n, depuraci\u00c3\u00b3n, revisi\u00c3\u00b3n de c\u00c3\u00b3digo",
      "mode": "subagent",
      "color": "#DC143C",
      "steps": 12,
      "temperature": 0.2,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "ask",
        "bash": {
          "git *": "allow",
          "py *": "allow",
          "npx *": "allow",
          "cargo *": "allow",
          "npm *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      },
      "tools": {
        "vault_*": true,
        "sequential-thinking_*": true,
        "git_*": true,
        "exa-search_*": true,
        "agy-bridge_agy_ask_flash": true,
        "agy-bridge_agy_ask_sonnet": true,
        "kaos-kanban_*": true
      }
    },
    "metis": {
      "type": "agent",
      "description": "Agente de estrategia \u2014 planeaci\u00f3n, OKRs, roadmaps, an\u00e1lisis competitivo, reportes ejecutivos y orquestador de calidad",
