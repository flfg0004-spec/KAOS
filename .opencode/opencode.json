{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "aletheia": {
      "description": "Agente de investigación — búsqueda web, papers, noticias, investigación profunda",
      "mode": "subagent",
      "color": "#4A90D9",
      "steps": 15,
      "temperature": 0.3,
      "permission": {
        "websearch": "allow",
        "webfetch": "allow",
        "read": "allow",
        "edit": "deny",
        "bash": {
          "curl *": "allow",
          "wget *": "allow",
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "task": "allow",
        "skill": "allow"
      },
      "tools": {
        "scholar-search_*": true,
        "rss-reader_*": true,
        "context7_*": true,
        "gptr-deep-research_*": true,
        "searxng_*": true,
        "crawl4ai_*": true,
        "exa-search_*": true,
        "depwire_*": true,
        "mcp-obsidian-cli_*": true
      }
    },
    "kosmos": {
      "description": "Agente de arquitectura — análisis de código, diagramas C4, documentación técnica",
      "mode": "subagent",
      "color": "#7B68EE",
      "steps": 10,
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "ask",
        "list": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "bash": {
          "git *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "find *": "allow",
          "tree *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "npx *": "allow",
          "uvx *": "allow",
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "ask"
        }
      },
      "tools": {
        "depwire_*": true,
        "structurizr_*": true,
        "excalidraw_*": true,
        "postgres_*": true,
        "git_*": true,
        "github_*": true,
        "lucidity_*": true,
        "mcp-obsidian-cli_*": true
      }
    },
    "metis": {
      "description": "Agente de estrategia — planeación, OKRs, roadmaps, análisis competitivo, reportes",
      "mode": "subagent",
      "color": "#E8A87C",
      "steps": 8,
      "temperature": 0.4,
      "permission": {
        "websearch": "allow",
        "webfetch": "allow",
        "read": "allow",
        "edit": "ask",
        "bash": {
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "task": "allow",
        "skill": "allow",
        "question": "allow",
        "todowrite": "allow"
      },
      "tools": {
        "excalidraw_*": true,
        "paperjsx_*": true,
        "exa-search_*": true,
        "mcp-obsidian-cli_*": true
      }
    },
    "mnemosyne": {
      "description": "Guardiana de la memoria — curación de conocimiento, wikilinks, calidad del vault",
      "mode": "subagent",
      "color": "#C0C0C0",
      "steps": 8,
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": {
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "skill": "allow"
      },
      "tools": {
        "sequential-thinking_*": true,
        "mcp-obsidian-cli_*": true
      }
    }
  },
  "tools": {
    "depwire_*": false,
    "structurizr_*": false,
    "excalidraw_*": false,
    "paperjsx_*": false,
    "scholar-search_*": false,
    "rss-reader_*": false,
    "context7_*": false,
    "postgres_*": false,
    "git_*": false,
    "github_*": false,
    "lucidity_*": false,
    "postgres_*": false,
    "mcp-obsidian-cli_*": false
  },
  "mcp": {
    "mcp-obsidian-cli": {
      "type": "local",
      "command": ["npx", "-y", "mcp-obsidian-cli"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_proxy.py", "--", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "depwire": {
      "type": "local",
      "command": ["npx", "-y", "@iflow-mcp/depwire-depwire"],
      "enabled": true
    },
    "excalidraw": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_proxy.py", "--", "npx", "-y", "excalidraw-mcp"],
      "enabled": true
    },
    "paperjsx": {
      "type": "local",
      "command": ["npx", "-y", "@paperjsx/mcp-server"],
      "enabled": true
    },
    "scholar-search": {
      "type": "local",
      "command": ["npx", "-y", "scholar-search-mcp"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-git", "--repository", "."],
      "enabled": true
    },
    "rss-reader": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_proxy.py", "--", "npx", "-y", "rss-reader-mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "vault": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_proxy.py", "--", "npx", "-y", "@modelcontextprotocol/server-filesystem",
        ".memory",
        ".memory/ingest",
        ".memory/cache",
        ".memory/wiki",
        ".memory/raw",
        ".memory/schema",
        ".vault/quality"
      ],
      "enabled": true
    },
    "exa-search": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server"],
      "enabled": true,
      "env": {
        "EXA_API_KEY": "6fa7bd38-4bb9-4667-acba-946c89bc9358"
      }
    },
    "gptr-deep-research": {
      "type": "local",
      "command": ["npx", "-y", "gpt-researcher-mcp"],
      "enabled": true,
      "env": {
        "GPTR_MODEL_PROVIDER": "deepseek",
        "GPTR_MODEL": "deepseek-v4-flash",
        "GPTR_REPORT_MODEL": "deepseek-v4-pro",
        "GPTR_SEARCH_PROVIDER": "exa",
        "GPTR_EXA_API_KEY": "6fa7bd38-4bb9-4667-acba-946c89bc9358"
      }
    },
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "searxng-mcp", "--url", "http://127.0.0.1:8888"],
      "enabled": true
    },
    "crawl4ai": {
      "type": "local",
      "command": ["npx", "-y", "crawl4ai-mcp-sse-stdio", "--url", "http://127.0.0.1:11235"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false
    },
    "lucidity": {
      "type": "local",
      "command": ["npx", "-y", "lucidity-mcp"],
      "enabled": false
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "--connection-string", "postgresql://localhost/kaos"],
      "enabled": false
    },
    "structurizr": {
      "type": "local",
      "command": ["npx", "-y", "@iljabauer/structurizr-mcp"],
      "enabled": false
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 5,
    "preserve_recent_tokens": 8000,
    "reserved": 4000
  },
  "command": {
    "quality": {
      "description": "Ejecuta smoke check de calidad del sistema KAOS",
      "template": "Ejecuta py -3 .tools/session_runner.py smoke desarrollo y muestra los resultados"
    },
    "investigate": {
      "description": "Invoca a Aletheia para investigar un tema",
      "template": "@aletheia investiga el siguiente tema: {{input}}",
      "agent": "aletheia",
      "subtask": true
    },
    "architect": {
      "description": "Invoca a Kosmos para análisis arquitectónico",
      "template": "@kosmos analiza la arquitectura de: {{input}}",
      "agent": "kosmos",
      "subtask": true
    },
    "strategy": {
      "description": "Invoca a Metis para análisis estratégico",
      "template": "@metis crea una estrategia para: {{input}}",
      "agent": "metis",
      "subtask": true
    }
  }
}
