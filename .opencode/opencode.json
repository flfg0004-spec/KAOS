{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "aletheia": {
      "description": "Agente de investigación — búsqueda web, papers, noticias, investigación profunda",
      "mode": "subagent",
      "color": "#4A90D9",
      "steps": 15,
      "temperature": 0.3,
      "permission": {
        "websearch": "allow",
        "webfetch": "allow",
        "read": "allow",
        "edit": "deny",
        "bash": {
          "curl *": "allow",
          "wget *": "allow",
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "task": "allow",
        "skill": "allow"
      },
      "tools": {
        "scholar-search_*": true,
        "rss-reader_*": true,
        "context7_*": true,
        "gptr-deep-research_*": true,
        "searxng_*": true,
        "crawl4ai_*": true,
        "exa-search_*": true,
        "depwire_*": true,
        "mcp-obsidian-cli_*": true,
        "sequential-thinking_*": true,
        "vault_*": true,
        "txtai_*": true,
        "obsidian_*": true,
        "agy-bridge_agy_ask_flash": true,
        "agy-bridge_agy_ask_sonnet": true,
        "agy-bridge_agy_ask_opus": true,
        "agy-bridge_agy_ask_gpt55": true
      }
    },
    "mnemosyne": {
      "description": "Guardiana de la memoria — curación de conocimiento, wikilinks, calidad del vault",
      "mode": "subagent",
      "color": "#C0C0C0",
      "steps": 14,
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "ask",
        "bash": {
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "skill": "allow"
      },
      "tools": {
        "sequential-thinking_*": true,
        "mcp-obsidian-cli_*": true,
        "vault_*": true,
        "txtai_*": true,
        "knowledge-graph_*": true,
        "obsidian_*": true,
        "mcp-embed_*": true,
        "dsol_*": true,
        "gaps_*": true,
        "contradictions_*": true,
        "lifecycle_*": true,
        "quality_*": true,
        "crossref_*": true,
        "agy-bridge_agy_status": true,
        "agy-bridge_agy_ask_flash": true
      }
    },
    "kosmos": {
      "description": "Agente de arquitectura — análisis de código, diagramas C4, documentación técnica",
      "mode": "subagent",
      "color": "#7B68EE",
      "steps": 10,
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "ask",
        "list": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "bash": {
          "git *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "find *": "allow",
          "tree *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "npx *": "allow",
          "uvx *": "allow",
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "ask"
        }
      },
      "tools": {
        "depwire_*": true,
        "structurizr_*": true,
        "excalidraw_*": true,
        "git_*": true,
        "lucidity_*": true,
        "mcp-obsidian-cli_*": true,
        "obsidian_*": true,
        "agy-bridge_agy_ask_sonnet": true,
        "agy-bridge_agy_ask_opus": true,
        "agy-bridge_agy_ask_gpt55": true,
        "agy-bridge_agy_ask_gpt55_thinking": true
      }
    },
    "metis": {
      "description": "Agente de estrategia — planeación, OKRs, roadmaps, análisis competitivo, reportes - orquestador del sistema DUAL",
      "mode": "subagent",
      "color": "#E8A87C",
      "steps": 12,
      "temperature": 0.4,
      "permission": {
        "websearch": "allow",
        "webfetch": "allow",
        "read": "allow",
        "edit": "ask",
        "bash": {
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "task": "allow",
        "skill": "allow",
        "question": "allow",
        "todowrite": "allow"
      },
      "tools": {
        "excalidraw_*": true,
        "paperjsx_*": true,
        "exa-search_*": true,
        "sequential-thinking_*": true,
        "dsol_*": true,
        "speed_*": true,
        "mcp-obsidian-cli_*": true,
        "obsidian_*": true,
        "vault_*": true,
        "strategy-mcp_*": true,
        "strategy-extras_*": true,
        "agy-bridge_agy_ask_flash": true,
        "agy-bridge_agy_ask_sonnet": true,
        "agy-bridge_agy_ask_opus": true,
        "agy-bridge_agy_ask_gpt55": true
      }
    },
    "kratos": {
      "description": "Agente de código — memoria experiencial, generación, depuración, revisión de código",
      "mode": "subagent",
      "color": "#DC143C",
      "steps": 12,
      "temperature": 0.2,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "ask",
        "bash": {
          "git *": "allow",
          "py *": "allow",
          "npx *": "allow",
          "cargo *": "allow",
          "npm *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      },
      "tools": {
        "vault_*": true,
        "sequential-thinking_*": true,
        "git_*": true,
        "exa-search_*": true,
        "mcp-obsidian-cli_*": true,
        "obsidian_*": true,
        "agy-bridge_agy_ask_flash": true,
        "agy-bridge_agy_ask_sonnet": true
      }
    }
  },
  "tools": {
    "depwire_*": false,
    "structurizr_*": false,
    "excalidraw_*": false,
    "paperjsx_*": false,
    "scholar-search_*": false,
    "rss-reader_*": false,
    "context7_*": false,
    "git_*": false,
    "mcp-obsidian-cli_*": false,
    "obsidian_*": false,
    "knowledge-graph_*": false,
    "vault_*": false,
    "sequential-thinking_*": false,
    "exa-search_*": false,
    "dsol_*": false,
    "gaps_*": false,
    "contradictions_*": false,
    "lifecycle_*": false,
    "quality_*": false,
    "crossref_*": false,
    "strategy-mcp_*": false,
    "strategy-extras_*": false,
    "agy-bridge_*": false
  },
  "mcp": {
    "mcp-obsidian-cli": {
      "type": "local",
      "command": ["npx", "-y", "mcp-obsidian-cli"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_proxy.py", "--", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "depwire": {
      "type": "local",
      "command": ["npx", "-y", "@iflow-mcp/depwire-depwire"],
      "enabled": true
    },
    "excalidraw": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_proxy.py", "--", "npx", "-y", "excalidraw-mcp"],
      "enabled": true
    },
    "paperjsx": {
      "type": "local",
      "command": ["npx", "-y", "@paperjsx/mcp-server"],
      "enabled": true
    },
    "scholar-search": {
      "type": "local",
      "command": ["npx", "-y", "scholar-search-mcp"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-git", "--repository", "."],
      "enabled": true
    },
    "rss-reader": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_proxy.py", "--", "npx", "-y", "rss-reader-mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "vault": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_proxy.py", "--", "npx", "-y", "@modelcontextprotocol/server-filesystem",
        ".memory",
        ".memory/ingest",
        ".memory/cache",
        ".memory/wiki",
        ".memory/raw",
        ".memory/schema",
        ".vault/quality"
      ],
      "enabled": true
    },
    "exa-search": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server"],
      "enabled": true,
      "env": {
        "EXA_API_KEY": "6fa7bd38-4bb9-4667-acba-946c89bc9358"
      }
    },
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "searxng-mcp", "--url", "http://127.0.0.1:8888"],
      "enabled": true
    },
    "crawl4ai": {
      "type": "local",
      "command": ["npx", "-y", "crawl4ai-mcp-sse-stdio", "--url", "http://127.0.0.1:11235"],
      "enabled": true
    },
    "txtai": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_txtai.py"],
      "enabled": true
    },
    "structurizr": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_structurizr.py"],
      "enabled": true
    },
    "lucidity": {
      "type": "local",
      "command": ["py", "-3", ".tools/run_lucidity.py"],
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "@swarogan/obsidian-mcp-rest"],
      "enabled": true,
      "env": {
        "OBSIDIAN_API_KEY": "",
        "OBSIDIAN_REST_URL": "https://127.0.0.1:27124"
      }
    },
    "mcp-embed": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_embed.py"],
      "enabled": true
    },
    "knowledge-graph": {
      "type": "local",
      "command": ["npx", "-y", "mcp-knowledge-graph", "--memory-path", ".memory/cache/knowledge-graph"],
      "enabled": true
    },
    "agy-bridge": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_agy_bridge.py"],
      "enabled": true,
      "timeout": 300
    },
    "strategy-mcp": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_strategy.py"],
      "enabled": true
    },
    "strategy-extras": {
      "type": "local",
      "command": ["py", "-3", ".memory/_scripts/mcp_strategy_extras.py"],
      "enabled": true
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 10,
    "preserve_recent_tokens": 16000,
    "reserved": 4000
  },
  "command": {
    "quality": {
      "description": "Ejecuta smoke check de calidad del sistema KAOS",
      "template": "Ejecuta py -3 .memory/_scripts/vault.py health --auto y py -3 .memory/_scripts/vault.py lint run, luego muestra los resultados"
    },
    "investigate": {
      "description": "Invoca a Aletheia para investigar un tema",
      "template": "@aletheia investiga el siguiente tema: {{input}}",
      "agent": "aletheia",
      "subtask": true
    },
    "architect": {
      "description": "Invoca a Kosmos para análisis arquitectónico",
      "template": "@kosmos analiza la arquitectura de: {{input}}",
      "agent": "kosmos",
      "subtask": true
    },
    "strategy": {
      "description": "Invoca a Metis para análisis estratégico con perfil",
      "template": "@metis desarrolla una estrategia para: {{input}} usando perfil {{profile}}",
      "agent": "metis",
      "subtask": true
    },
    "curate": {
      "description": "Ejecuta ciclo completo de curaduría Mnemosyne (14 fases)",
      "template": "Ejecuta py -3 .memory/_scripts/run_curation.py y luego py -3 .memory/_scripts/vault.py curation report, reporta el resumen de curaduría",
      "agent": "mnemosyne",
      "subtask": true
    }
  }
}

