      "mode": "subagent",
      "color": "#C0C0C0",
      "steps": 14,
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "delete": {
          ".memory/wiki/concepts/*": "allow",
          ".memory/raw/*": "allow",
          ".vault/quality/*": "allow",
          "*": "deny"
        },
        "bash": {
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "skill": "allow",
        "task": "allow"
      },
      "tools": {
        "sequential-thinking_*": true,
        "vault_*": true,
        "txtai_*": true,
        "knowledge-graph_*": true,
        "mcp-embed_*": true,
        "gaps_*": true,
        "quality_*": true,
        "crossref_*": true,
        "lifecycle_*": true,
        "knowledge-scorer_*": true,
        "knowledge-synthesis_*": true,
        "mcp-dsol_*": true,
        "agy-bridge_agy_ask_flash": true
