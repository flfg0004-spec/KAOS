      "file": ".opencode/agents/metis/SOUL.md",
      "temperature": 0.4,
      "color": "#E8A87C",
      "steps": 12,
      "tools": {
        "exa-search_web_search_exa": true,
        "exa-search_web_fetch_exa": true,
        "sequential-thinking_sequential-thinking": true,
        "strategy-mcp_*": true,
        "strategy-extras_*": true,
        "excalidraw_*": true,
        "paperjsx_*": true,
        "vault_*": true,
        "mcp-obsidian-cli_*": true,
        "agy-bridge_agy_ask_flash": true,
        "agy-bridge_agy_ask_sonnet": true,
        "agy-bridge_agy_ask_opus": true,
        "agy-bridge_agy_ask_gpt55": true,
        "mcp-dsol_*": true,
        "mcp-speed_*": true,
        "mcp-pandas_*": true,
        "mcp-simulate_*": true,
        "mcp-causal-graph_*": true,
        "mcp-strategy-feedback_*": true,
        "mcp-post-output-hook_*": true,
        "mcp-creative-spark_*": true,
        "mcp-roadmap-3h_*": true,
        "mcp-verification-chain_*": true,
        "mcp-session-runner_*": true
      }
    },
    "kronos": {
      "description": "Orquestador \u2014 an\u00e1lisis de pipelines, routing adaptativo, recuperaci\u00f3n de errores",
      "mode": "subagent",
      "color": "#FFD700",
      "steps": 10,
      "temperature": 0.2,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": {
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "task": "allow",
        "skill": "allow"
      },
      "tools": {
        "vault_*": true,
        "sequential-thinking_*": true,
        "mcp-speed_*": true,
        "mcp-dsol_*": true,
        "mcp-pipeline_*": true,
        "lifecycle_*": true,
        "quality_*": true,
        "gaps_*": true,
        "txtai_*": true,
        "knowledge-graph_*": true
      }
    }
