{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "aletheia": {
      "description": "Agente de investigaciÃ³n â€” bÃºsqueda web, papers, noticias, investigaciÃ³n profunda",
      "mode": "subagent",
      "color": "#4A90D9",
      "steps": 15,
      "temperature": 0.3,
      "permission": {
        "websearch": "allow",
        "webfetch": "allow",
        "read": "allow",
        "edit": "deny",
        "bash": {
          "curl *": "allow",
          "wget *": "allow",
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "task": "allow",
        "skill": "allow"
      },
      "tools": {
        "scholar-search_*": true,
        "rss-reader_*": true,
        "context7_*": true,
        "searxng_*": true,
        "crawl4ai_*": true,
        "exa-search_*": true,
        "sequential-thinking_*": true,
        "vault_*": true,
        "txtai_*": true,
        "knowledge-graph_*": true,
        "agy-bridge_agy_ask_flash": true,
        "agy-bridge_agy_ask_sonnet": true,
        "agy-bridge_agy_ask_opus": true,
        "agy-bridge_agy_ask_gpt55": true,
        "agy-bridge_agy_ask_gpt55_thinking": true,
    "hermes-gateway_*": true,
    "hermes-bridge_*": true,
    "kaos-kanban_*": true,
    "mcp-verification-chain_*": false,
    "mcp-session-runner_*": false
  },
  "mcp": {
    "mcp-obsidian-cli": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-obsidian-cli"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_proxy.py",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "depwire": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@iflow-mcp/depwire-depwire"
      ],
      "enabled": true
    },
    "excalidraw": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_proxy.py",
        "--",
        "npx",
        "-y",
        "excalidraw-mcp"
      ],
      "enabled": true
    },
    "paperjsx": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@paperjsx/mcp-server"
      ],
      "enabled": true
    },
    "scholar-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "scholar-search-mcp"
      ],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-git",
        "--repository",
        "."
      ],
      "enabled": true
    },
    "server-github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true
    },
    "rss-reader": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_proxy.py",
        "--",
        "npx",
        "-y",
        "rss-reader-mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "vault": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_proxy.py",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        ".memory",
        ".memory/ingest",
        ".memory/cache",
        ".memory/wiki",
        ".memory/raw",
        ".memory/schema",
        ".vault/quality"
      ],
      "enabled": true
    },
    "exa-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "exa-mcp-server"
      ],
      "enabled": true
    },
    "searxng": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "searxng-mcp",
        "--url",
        "http://127.0.0.1:8888"
      ],
      "enabled": true
    },
    "crawl4ai": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "crawl4ai-mcp-sse-stdio",
        "--url",
        "http://127.0.0.1:11235"
      ],
      "enabled": true
    },
    "txtai": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_txtai.py"
      ],
      "enabled": true
    },
    "structurizr": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_structurizr.py"
      ],
      "enabled": true
    },
    "lucidity": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".tools/run_lucidity.py"
      ],
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@swarogan/obsidian-mcp-rest"
      ],
      "enabled": false,
      "env": {
        "OBSIDIAN_API_KEY": "ROTATED-20260526",
        "OBSIDIAN_REST_URL": "https://127.0.0.1:27124"
      }
    },
    "mcp-embed": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_embed.py"
      ],
      "enabled": true
    },
    "mcp-speed": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_speed.py"
      ],
      "enabled": true
    },
    "mcp-dsol": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_dsol.py"
      ],
      "enabled": true
    },
    "knowledge-graph": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-knowledge-graph",
        "--memory-path",
        ".memory/cache/knowledge-graph"
      ],
      "enabled": true
    },
    "agy-bridge": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_agy_bridge.py"
      ],
      "enabled": true,
      "timeout": 300
    },
    "strategy-mcp": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_strategy.py"
      ],
      "enabled": true
    },
    "strategy-extras": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_strategy_extras.py"
      ],
      "enabled": true
    },
    "mcp-pandas": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_pandas.py",
        "interactive"
      ],
      "enabled": true
    },
    "mcp-simulate": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_simulate.py"
      ],
      "enabled": true
    },
    "mcp-causal-graph": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_causal_graph.py"
      ],
      "enabled": true
    },
    "mcp-strategy-feedback": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_strategy_feedback.py"
      ],
      "enabled": true
    },
    "hermes-gateway": {
      "type": "local",
      "command": [
        "hermes",
        "mcp",
        "serve",
        "--accept-hooks"
      ],
      "enabled": true,
      "timeout": 600
    },
    "mcp-creative-spark": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_creative_spark.py"
      ],
      "enabled": true
    },
    "mcp-roadmap-3h": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_roadmap_3h.py"
      ],
      "enabled": true
    },
    "mcp-post-output-hook": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_post_output_hook.py"
      ],
      "enabled": true
    },
    "kaos-kanban": {
      "type": "local",
      "command": [
        "hermes",
        "kanban",
        "--json"
      ],
      "enabled": true
    },
    "mcp-verification-chain": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_verification_chain.py"
      ],
      "enabled": true
    },
    "mcp-session-runner": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_session_runner.py"
      ],
      "enabled": true
    },
    "pipeline": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_pipeline.py"
      ],
      "enabled": true
    },
    "hermes-bridge": {
      "type": "local",
      "command": [
        "py",
        "-3",
        ".memory/_scripts/mcp_hermes_bridge.py"
      ],
      "enabled": true,
      "description": "Hermes Tool Bridge — progressive disclosure for MCP tools (search/describe/call)"
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 10,
    "preserve_recent_tokens": 16000,
    "reserved": 4000
  }
}