      "color": "#C0C0C0",
      "steps": 14,
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": {
          "py *": "allow",
          ".memory/_scripts/*": "allow",
          "*": "deny"
        },
        "skill": "allow"
      },
      "tools": {
        "sequential-thinking_*": true,
        "mcp-obsidian-cli_*": true,
        "vault_*": true,
        "txtai_*": true,
