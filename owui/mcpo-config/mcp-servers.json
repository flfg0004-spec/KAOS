{
  "mcpServers": {
    "kaos-vault": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", ".memory", ".memory/ingest", ".memory/wiki", ".memory/schema", ".vault/quality"],
      "env": {}
    },
    "kaos-txtai": {
      "command": "py",
      "args": ["-3", ".memory/_scripts/mcp_txtai.py"],
      "env": {}
    },
    "kaos-search": {
      "command": "npx",
      "args": ["-y", "searxng-mcp", "--url", "http://127.0.0.1:8888"],
      "env": {}
    },
    "kaos-reason": {
      "command": "py",
      "args": ["-3", ".memory/_scripts/mcp_proxy.py", "--", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {}
    },
    "kaos-obsidian": {
      "command": "npx",
      "args": ["-y", "@swarogan/obsidian-mcp-rest"],
      "env": {
        "OBSIDIAN_API_KEY": "",
        "OBSIDIAN_REST_URL": "https://127.0.0.1:27124"
      }
    },
    "kaos-exa-search": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": "6fa7bd38-4bb9-4667-acba-946c89bc9358"
      }
    },
    "kaos-knowledge-graph": {
      "command": "npx",
      "args": ["-y", "mcp-knowledge-graph", "--memory-path", ".memory/cache/knowledge-graph"],
      "env": {}
    },
    "kaos-strategy": {
      "command": "py",
      "args": ["-3", ".memory/_scripts/mcp_strategy.py"],
      "env": {}
    }
  }
}
