{
  "kaos-companion-hooks": {
    "PreToolUse": [
      {
        "matcher": "run_command|command",
        "hooks": []
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write|edit|delete",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .memory/_scripts/vault.py lint run",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .memory/_scripts/vault.py health --auto",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
