{
  "$schema": "https://antigravity.google/schemas/workspace-config.json",
  "project": {
    "id": "kaos-companion",
    "name": "KAOS Companion",
    "version": "3.0.0",
    "description": "Companion agent for KAOS vault operations"
  },
  "isolation": {
    "mode": "open",
    "sharedDirectories": [
      ".memory/",
      ".tools/",
      ".vault/"
    ]
  },
  "settings": {
    "defaultAgent": "KAOS-Companion",
    "permissions": {
      "mode": "developer-optimized",
      "autoApprove": {
        "commands": [
          "git *",
          "py *",
          "python *",
          "Get-ChildItem *",
          "Test-Path *"
        ],
        "directories": [
          ".memory/*",
          ".tools/*",
          ".vault/*"
        ]
      }
    }
  }
}
