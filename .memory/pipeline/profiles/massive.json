{
  "name": "massive",
  "description": "Ingesta Masiva — 4+ hrs, crawleo completo, embedding y síntesis STORM, para documentación/webs grandes",
  "depth": 99,
  "max_queries": 100,
  "parallel_queries": true,
  "sub_iterations": 5,
  "tools": ["crawl4ai", "gptr-deep-research", "searxng", "exa-search", "sequential-thinking"],
  "thinking_mode": "high",
  "token_budget": {"min": 16384, "optimal": 32768, "max": 65536},
  "model": "deepseek-v4-pro",
  "json_output": false,
  "output": {
    "format": "wiki-ready",
    "sections": ["resumen-ejecutivo", "indice-contenidos", "conceptos-extraidos", "entidades-detectadas", "relaciones", "fuentes-completas"],
    "max_length": 50000
  },
  "triangulation": true,
  "min_sources": 3,
  "auto_scrape_references": true,
  "generate_embeddings": true,
  "generate_wikilinks": true,
  "generate_adr": false,
  "time_estimate_min": 240
}
