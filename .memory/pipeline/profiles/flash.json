{
  "name": "flash",
  "description": "Búsqueda rápida — 5-10 min, shallow, para fact-checking o consultas simples",
  "depth": 1,
  "max_queries": 5,
  "parallel_queries": true,
  "sub_iterations": 0,
  "tools": ["exa-search"],
  "thinking_mode": null,
  "token_budget": {"min": 1024, "optimal": 4096, "max": 8192},
  "model": "deepseek-v4-flash",
  "json_output": true,
  "output": {
    "format": "brief",
    "sections": ["hallazgos", "fuentes"],
    "max_length": 500
  },
  "triangulation": false,
  "confidence_matrix": false,
  "time_estimate_min": 5
}
