{
  "name": "deep",
  "description": "Deep Research — 2-4 hrs, multi-query tree, triangulación automática, reporte exhaustivo",
  "depth": 4,
  "max_queries": 30,
  "parallel_queries": false,
  "sub_iterations": 3,
  "tools": ["gptr-deep-research", "exa-search", "searxng", "crawl4ai", "sequential-thinking", "scholar-search"],
  "thinking_mode": "xmax",
  "token_budget": {"min": 8192, "optimal": 16384, "max": 65536},
  "model": "deepseek-v4-pro",
  "json_output": false,
  "output": {
    "format": "comprehensive",
    "sections": ["resumen-ejecutivo", "metodologia", "hallazgos-detallados", "matriz-confianza-extendida", "citas-textuales", "fuentes-completas", "contradicciones", "pendientes"],
    "max_length": 10000
  },
  "triangulation": true,
  "min_sources": 5,
  "auto_scrape_references": true,
  "confidence_matrix": true,
  "fact_check_external": true,
  "time_estimate_min": 120
}
