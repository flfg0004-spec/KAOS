# KAOS Environment Variables
# Copy this file to .env and fill in your keys

# LLM Provider Keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
OPENCODE_GO_KEY=sk-your-opencode-go-key-here

# MCP Server API Keys
EXA_API_KEY=your-exa-api-key-here
OBSIDIAN_API_KEY=your-obsidian-api-key-here

# API Endpoints
OPENCODE_GO_ENDPOINT=https://opencode.ai/zen/go/v1

# Telegram Bot
TELEGRAM_BOT_TOKEN=tu-token-de-bot-aqui
TELEGRAM_CHAT_ID=1487561068

# Telegram Power Management
POWER_CONFIRM_TIMEOUT=60

# Telegram File Browser (semicolon-separated)
TELEGRAM_ALLOWED_PATHS=C:\Users\LeonX\Documents\KAOS;C:\Users\LeonX\Documents

# Telegram System Monitor
TELEGRAM_MONITOR_INTERVAL=300
TELEGRAM_ALERT_COOLDOWN=600

# Hermes Gateway
HERMES_ENABLED=true
HERMES_CHANNEL=kaos-ci
HERMES_BIN=hermes
HERMES_KANBAN_POLL=30
HERMES_OUTBOX_ENABLED=true

# DeerFlow + Agno LIVE mode
DEERFLOW_ENABLED=false
AGNO_ENABLED=false

# LangFuse
LANGFUSE_SECRET=change-me-langfuse-secret
LANGFUSE_SALT=change-me-langfuse-salt

# Feature Flags
LLM_DIRECT_ENABLED=true
EXECUTOR_ENABLED=false
RAG_ENABLED=true

# Agent Configuration
MOME_THRESHOLD=10000
RAG_TOP_K=5
EXECUTOR_TIMEOUT=300

# Ether — Token Harmonization & Execution Regulation (antes DSOL)
ETHER_DEFAULT_MODEL=go-flash
ETHER_CIRCUIT_BREAKER_ENABLED=true
ETHER_CIRCUIT_RESET_TIMEOUT=300
ETHER_FAILURE_THRESHOLD=3
ETHER_HALF_OPEN_MAX=1

# [DEPRECATED] Use ETHER_* instead
ROUTER_DEFAULT_MODEL=go-flash
ROUTER_CIRCUIT_BREAKER_ENABLED=true
ROUTER_CIRCUIT_RESET_TIMEOUT=300
ROUTER_FAILURE_THRESHOLD=3
ROUTER_HALF_OPEN_MAX=1

# LangSmith Observability
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=kaos-pipeline
