# KAOS Environment Variables
# Copy this file to .env and fill in your keys

# LLM Provider Keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
OPENCODE_GO_KEY=sk-your-opencode-go-key-here

# MCP Server API Keys
EXA_API_KEY=your-exa-api-key-here
OBSIDIAN_API_KEY=your-obsidian-api-key-here

# API Endpoints
OPENCODE_GO_ENDPOINT=https://opencode.ai/zen/go/v1

# Feature Flags
LLM_DIRECT_ENABLED=true
HERMES_ENABLED=true
EXECUTOR_ENABLED=false
RAG_ENABLED=true

# Agent Configuration
HERMES_CHANNEL=kaos-ci
MOME_THRESHOLD=10000
RAG_TOP_K=5
EXECUTOR_TIMEOUT=300
