{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strategy Transfer Contract",
  "description": "Contrato Metis→Kosmos para transferencia formal de OKRs, roadmaps y especificaciones estratégicas como input de diseño arquitectónico",
  "type": "object",
  "properties": {
    "type": { "type": "string", "enum": ["strategy_transfer", "okr_batch"] },
    "session_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "profile": { "type": "string", "enum": ["exploracion", "desarrollo", "produccion"] },
    "strategy": { "type": "string", "description": "Resumen estratégico de alto nivel" },
    "okrs": {
      "type": "array",
      "items": { "$ref": "#/definitions/okr" },
      "minItems": 1
    },
    "roadmap": {
      "type": "object",
      "properties": {
        "horizons": {
          "type": "object",
          "properties": {
            "h1": { "$ref": "#/definitions/horizon" },
            "h2": { "$ref": "#/definitions/horizon" },
            "h3": { "$ref": "#/definitions/horizon" }
          },
          "required": ["h1", "h2", "h3"]
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/definitions/risk" }
    },
    "confidence": { "type": "string", "enum": ["alta", "media", "baja"] },
    "architectural_constraints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Restricciones arquitectónicas que Kosmos debe considerar"
    }
  },
  "required": ["type", "session_id", "generated_at", "strategy", "okrs"],
  "definitions": {
    "okr": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^O[0-9]+$" },
        "objective": { "type": "string", "minLength": 10 },
        "key_results": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "KR con target numérico y timeline"
          },
          "minItems": 1
        },
        "initiatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^I[0-9]+$" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "rice_score": { "type": "number", "minimum": 0, "maximum": 100 },
              "dependencies": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["id", "title"]
          }
        },
        "bcg_score": { "type": "number", "minimum": 0, "maximum": 10 },
        "health_check": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "required": ["objective", "key_results"]
    },
    "horizon": {
      "type": "object",
      "properties": {
        "period": { "type": "string" },
        "initiatives": { "type": "array", "items": { "type": "string" } },
        "focus": { "type": "string" }
      },
      "required": ["period", "focus"]
    },
    "risk": {
      "type": "object",
      "properties": {
        "risk": { "type": "string" },
        "probability": { "type": "string", "enum": ["alta", "media", "baja"] },
        "impact": { "type": "string", "enum": ["alto", "medio", "bajo"] },
        "mitigation": { "type": "string" }
      },
      "required": ["risk", "probability", "impact"]
    }
  }
}
