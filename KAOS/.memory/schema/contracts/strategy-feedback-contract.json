{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strategy Feedback Contract",
  "description": "Contrato Kratos→Metis para reporte de métricas de calidad de implementación táctica, cerrando el feedback loop entre estrategia y código",
  "type": "object",
  "properties": {
    "type": { "type": "string", "enum": ["strategy_feedback"] },
    "session_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "okr_id": { "type": "string", "description": "OKR al que pertenece la initiative" },
    "initiative_id": { "type": "string", "description": "ID de la initiative implementada" },
    "initiative_title": { "type": "string" },
    "completion": {
      "type": "object",
      "properties": {
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": { "type": "string", "enum": ["complete", "partial", "blocked", "not_started"] },
        "completed_at": { "type": "string", "format": "date-time" }
      },
      "required": ["percentage", "status"]
    },
    "code_quality": {
      "type": "object",
      "properties": {
        "test_coverage": { "type": "number", "minimum": 0, "maximum": 100 },
        "cyclomatic_complexity": { "type": "number", "minimum": 0 },
        "lint_errors": { "type": "integer", "minimum": 0 },
        "tech_debt_minutes": { "type": "integer", "minimum": 0 },
        "code_smells": { "type": "integer", "minimum": 0 },
        "duplication_percentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "latency_ms": { "type": "number", "minimum": 0 },
        "throughput_rps": { "type": "number", "minimum": 0 },
        "memory_mb": { "type": "number", "minimum": 0 },
        "error_rate": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
          "status": { "type": "string", "enum": ["open", "resolved", "mitigated"] }
        },
        "required": ["description", "severity"]
      }
    },
    "estimated_remaining_effort": {
      "type": "object",
      "properties": {
        "hours": { "type": "number", "minimum": 0 },
        "confidence": { "type": "string", "enum": ["alta", "media", "baja"] }
      }
    },
    "success_criteria_met": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": { "type": "string" },
          "met": { "type": "boolean" },
          "actual_value": { "type": "string" }
        },
        "required": ["criterion", "met"]
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "priority": { "type": "string", "enum": ["alta", "media", "baja"] },
          "impact": { "type": "string" }
        },
        "required": ["action", "priority"]
      }
    }
  },
  "required": [
    "type", "session_id", "generated_at",
    "initiative_title", "completion"
  ]
}
